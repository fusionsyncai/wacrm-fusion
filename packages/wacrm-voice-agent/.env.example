# Copy to .env before `lk agent create` (LiveKit CLI reads this as the secrets file).
# cp .env.example .env

# Required — must match VOICE_CALLBACK_SECRET in wacrm (.env.local / Vercel)
VOICE_CALLBACK_SECRET=

# Optional for cloud deploy (lk cloud auth injects LiveKit creds on the agent).
# Required for local dev: python -m wacrm_voice_agent.agent dev
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional — defaults to wacrm-voice (must match Settings → LiveKit voice)
LIVEKIT_AGENT_NAME=wacrm-voice
